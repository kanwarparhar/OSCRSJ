NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# ORCID OAuth (Public API - from orcid.org/developer-tools)
NEXT_PUBLIC_ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Cloudflare Turnstile (CAPTCHA - from dash.cloudflare.com/turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (transactional email - https://resend.com/api-keys)
RESEND_API_KEY=
# Set after creating the webhook in the Resend dashboard
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="OSCRSJ Editorial Office <noreply@oscrsj.com>"
# Reply-To on every outbound transactional email. Route replies to a
# monitored mailbox so noreply@ doesn't accidentally swallow them.
EMAIL_REPLY_TO=oscrsjournal@gmail.com

# JWT secret for co-author dispute tokens (32-byte hex; generate via `openssl rand -hex 32`)
DISPUTE_TOKEN_SECRET=

# OSCRSJ Renderer (separate Next.js app at ~/Documents/oscrsj-renderer/).
# Used by the admin manuscript page's "Render published PDF" button.
# Dev default is the renderer's `npm run dev` port. Flip to the hosted
# URL when the renderer moves off localhost.
NEXT_PUBLIC_RENDERER_URL=http://localhost:3001

# Shared secret between OSCRSJ main app and the renderer. The renderer
# sends `Authorization: Bearer ${RENDERER_SHARED_SECRET}` when fetching
# the synthesized payload from `/api/publish/payload/[id]`. Generate via
# `openssl rand -hex 32` and set the same value on the renderer's env.
RENDERER_SHARED_SECRET=

# DeepSeek API key (platform.deepseek.com) — powers the Submission Studio's
# reference parsing + title-page extraction. Without it the pipeline degrades
# to deterministic fallbacks (references pass through unstructured).
DEEPSEEK_API_KEY=

# Bearer token gating every /api/cron/* route (generate via `openssl rand -hex 32`;
# Vercel Cron sends it automatically once set in the project env).
CRON_SECRET=

# Google Sheets usage log (Apps Script web app) — Formatter/Finder submission rows.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Optional: per-result "why this fits" one-liners in the Journal Finder
# (needs DEEPSEEK_API_KEY too; scoring is never affected). Off by default.
# FINDER_EXPLAIN_ENABLED=1

# Stripe (APC invoicing — https://dashboard.stripe.com/apikeys)
# Use sk_test_… until an invoice has round-tripped end to end in test
# mode. The app degrades safely when this is unset: the admin APC panel
# renders a "payments not configured" state instead of throwing.
STRIPE_SECRET_KEY=
# Signing secret from the webhook endpoint you create at
# https://dashboard.stripe.com/webhooks pointing at
#   https://www.oscrsj.com/api/webhooks/stripe
# The `www` is NOT optional — apex oscrsj.com 307s and Stripe does not
# re-issue the body on redirect. This exact mistake silently broke the
# Resend webhook (Session 5).
# Test mode and live mode have DIFFERENT signing secrets. Swapping
# sk_test_ for sk_live_ without also swapping this is the most common
# go-live failure.
STRIPE_WEBHOOK_SECRET=

# ---- Crossref DOI deposit (lib/publish/crossref) ----
# Unset = every deposit call is a safe no-op, exactly like the Google Sheets
# integration. Nothing breaks locally or in preview without these.
#
# login_id for a PERSONAL credential is the `email/role` form, e.g.
# `someone@example.com/bbcw` — check the credential email from Crossref, it is
# NOT just the email address.
CROSSREF_DEPOSIT_USER=
CROSSREF_DEPOSIT_PASSWORD=
CROSSREF_DEPOSITOR_EMAIL=
CROSSREF_DOI_PREFIX=10.67687

# TEST system (default — registers nothing real). Run a full clean batch here
# before touching production; a bad production deposit cannot be withdrawn,
# only superseded.
CROSSREF_DEPOSIT_URL=https://test.crossref.org/servlet/deposit
CROSSREF_QUERY_URL=https://test.crossref.org/servlet/submissionDownload
# PRODUCTION (flip both together, redeploy, then deposit e0001 ALONE first):
# CROSSREF_DEPOSIT_URL=https://doi.crossref.org/servlet/deposit
# CROSSREF_QUERY_URL=https://doi.crossref.org/servlet/submissionDownload
